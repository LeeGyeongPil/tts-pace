# No API key is needed. All variables are optional.
# Where fit() stores cached results when caching is enabled (CLI default: $XDG_CACHE_HOME/tts-pace or ~/.cache/tts-pace; the library fit() caches only when cache_dir is given or this variable is set)
TTS_PACE_CACHE_DIR=
# Path to the ffmpeg executable (default: search PATH; without it the numpy backends are used)
TTS_PACE_FFMPEG=
# Path to a Piper voice .onnx file (only for `--engine piper`)
TTS_PACE_PIPER_VOICE=
